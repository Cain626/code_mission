reports/profile_*.md

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 本地会话/工作目录（不入库）----
.workbuddy/

# ---- 密钥 ----
.env
*.key
*.pem
